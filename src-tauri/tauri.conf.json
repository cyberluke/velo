{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velo Pro",
  "version": "0.4.21",
  "identifier": "com.anydaysomething.velopro",
  "mainBinaryName": "Velo Pro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Velo Pro",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 400,
        "height": 300,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#0c1222"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src https: https://*.amazonaws.com http://localhost:11434 http://localhost:1234 http://127.0.0.1:11434 http://127.0.0.1:1234; img-src 'self' data: blob: https: http:; font-src 'self' data:; frame-src 'self'"
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-",
      "bundleVersion": "010"
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE"
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:velo.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0RkUyQkFEM0JBODJEQTcKUldTbkxhZzdyU3YrNUpaMDk2YkZLVnBnWms3R1lsSWZqcUNneWkxVUJLck5vOHlSRVJiQmZpdTYK",
      "endpoints": [
        "https://github.com/cyberluke/velo/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "mailto",
          "velo"
        ]
      }
    }
  }
}
